{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nocode": {
      "type": "remote",
      "url": "http://127.0.0.1:8787/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:NOCODE_GATEWAY_TOKEN}"
      },
      "timeout": 15000
    }
  }
}