        "targets": [
          {
            "azureLogAnalytics": {
              "dashboardTime": true,
              "query": "let M = AppMetrics; let Prompts = toscalar(M | where Name == \"nocode.prompts\" | summarize coalesce(sum(Sum), 0.0)); let Sessions = toscalar(M | where Name == \"nocode.runtime.events\" and tostring(Properties[\"event.type\"]) in (\"session.completed\", \"session.failed\") | summarize coalesce(sum(Sum), 0.0)); let PromptChars = toscalar(M | where Name == \"nocode.prompt.size_characters\" | summarize coalesce(sum(Sum), 0.0)); let PromptSamples = toscalar(M | where Name == \"nocode.prompt.size_characters\" | summarize coalesce(sum(ItemCount), 0)); let Turns = toscalar(M | where Name == \"nocode.model.turns\" | summarize coalesce(sum(Sum), 0.0)); let FixedBytes = toscalar(M | where Name == \"nocode.model.fixed_input_bytes\" | summarize coalesce(sum(Sum), 0.0)); let InputTokens = toscalar(M | where Name == \"nocode.model.input_tokens\" | summarize coalesce(sum(Sum), 0.0)); let RequestBytes = toscalar(M | where Name == \"nocode.model.request_bytes\" | summarize coalesce(sum(Sum), 0.0)); let UserChars = toscalar(M | where Name == \"nocode.model.user_input_characters\" | summarize coalesce(sum(Sum), 0.0)); let Models = toscalar(M | where Name == \"nocode.model.turns\" | extend Model=tostring(Properties[\"model.name\"]) | where isnotempty(Model) | summarize dcount(Model)); print PromptsPerSession=Prompts/max_of(Sessions,1.0), AveragePromptSize=PromptChars/max_of(todouble(PromptSamples),1.0), FixedOverheadPerCall=FixedBytes/max_of(Turns,1.0), ContextGrowthPerPrompt=InputTokens/max_of(Prompts,1.0), ContextDilution=100.0*UserChars/max_of(RequestBytes,1.0), ModelsInScope=Models",
              "resources": [
                "/subscriptions/37258c92-a17f-432c-afaa-b896a7798736/resourceGroups/rg-nocode-session-dev/providers/Microsoft.OperationalInsights/workspaces/log-nocode-session-dev"
              ],
