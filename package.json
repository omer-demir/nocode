{
  "name": "nocode-agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentctl": "dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli/index.ts",
    "gateway": "tsx src/gateway/index.ts",
    "observability:down": "docker compose down --remove-orphans",
    "observability:up": "docker compose up -d",
    "sandbox:build": "docker build -t nocode/coding-sandbox:0.2.0 sandbox-images/coding",
    "sandbox:smoke:azure": "tsx src/sandbox/azure-session-smoke.ts",
    "test": "tsx --test tests/*.test.ts",
    "tui": "tsx src/tui/index.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:samples": "tsc -p samples/external-clients/pi/tsconfig.json",
    "trace:smoke": "tsx src/telemetry/smoke.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/monitor-opentelemetry": "^1.20.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "tar": "^7.5.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.2",
    "tsx": "^4.19.3",
    "typebox": "^1.3.34",
    "typescript": "^5.7.3"
  }
}
