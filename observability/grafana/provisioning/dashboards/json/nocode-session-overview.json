    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Privacy-safe aggregate measurements derived from prompt and model request metadata. No prompt text is exported.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "decimals": 1,
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Median Prompt Size" },
            "properties": [{ "id": "unit", "value": "locale" }]
          },
          {
            "matcher": { "id": "byName", "options": "Fixed Overhead / Call" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "Context Dilution" },
            "properties": [{ "id": "unit", "value": "percent" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(nocode_prompts_total[$__range])) / clamp_min(sum(increase(nocode_runtime_events_total{event_type=~\"session.completed|session.failed\"}[$__range])), 1)",
          "instant": true,
          "legendFormat": "Prompts / Session",
          "range": false,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(nocode_prompt_size_characters_bucket[$__range])))",
          "instant": true,
          "legendFormat": "Median Prompt Size",
          "range": false,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum(increase(nocode_model_fixed_input_bytes_total[$__range])) / clamp_min(sum(increase(nocode_model_turns_total[$__range])), 1)",
          "instant": true,
          "legendFormat": "Fixed Overhead / Call",
          "range": false,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "sum(increase(nocode_model_input_tokens_total[$__range])) / clamp_min(sum(increase(nocode_prompts_total[$__range])), 1)",
          "instant": true,
          "legendFormat": "Context Growth / Prompt",
          "range": false,
          "refId": "D"
        },
        {
          "editorMode": "code",
          "expr": "100 * sum(increase(nocode_model_user_input_characters_total[$__range])) / clamp_min(sum(increase(nocode_model_request_bytes_total[$__range])), 1)",
          "instant": true,
          "legendFormat": "Context Dilution",
          "range": false,
          "refId": "E"
        },
        {
          "editorMode": "code",
          "expr": "count(count by (model_name) (increase(nocode_model_turns_total[$__range]) > 0))",
          "instant": true,
          "legendFormat": "Models In Scope",
          "range": false,
          "refId": "F"
        }
      ],
      "title": "Prompt And Context KPIs",
      "type": "stat"
    },
